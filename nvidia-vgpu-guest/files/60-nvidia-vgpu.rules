# NVIDIA GRID vGPU guest device nodes.
#
# Match NVIDIA's upstream udev integration. The PCI device's kernel name is
# its BDF (for example 0000:00:10.0), not "nvidia", so match its attributes
# and bound driver instead of KERNEL=="nvidia".
#
# The first invocation creates the control node; -c0 creates GPU minor 0 and
# -u creates the UVM devices. -m creates the optional modeset device.
ACTION=="add|bind", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", DRIVER=="nvidia", TEST!="/dev/nvidia-uvm", RUN+="/usr/bin/nvidia-modprobe"
ACTION=="add|bind", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", DRIVER=="nvidia", TEST!="/dev/nvidia-uvm", RUN+="/usr/bin/nvidia-modprobe -c0 -u"
ACTION=="add|bind", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", DRIVER=="nvidia", TEST!="/dev/nvidia-uvm", RUN+="/usr/bin/nvidia-modprobe -m"
