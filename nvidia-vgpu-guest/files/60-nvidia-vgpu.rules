# NVIDIA GRID vGPU guest device nodes.
#
# NVIDIA's kernel driver registers the "nvidia" character device when the
# nvidia module is loaded. Talos does not ship the distro udev integration
# that normally invokes nvidia-modprobe, so create the character devices here.
# udev runs RUN helpers as root; nvidia-modprobe does not need setuid.
ACTION=="add|bind", KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe"
ACTION=="add|bind", KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe -u"
ACTION=="add|bind", KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe -m"
