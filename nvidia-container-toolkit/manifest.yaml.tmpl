version: v1alpha1
metadata:
  name: nvidia-container-toolkit
  version: "1.18.2-{{ .BUILD_ARG_TALOS_VERSION }}"
  author: shokohsc
  description: |
    NVIDIA Container Toolkit runtime, CLI, hooks, and libnvidia-container with a private glibc runtime for Talos Linux.
    This extension does not install or replace the NVIDIA GPU driver.
  compatibility:
    talos:
      version: "= {{ .BUILD_ARG_TALOS_VERSION }}"
